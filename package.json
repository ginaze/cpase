{
	"name": "todomvc",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vp test",
		"lint": "vp check",
		"format": "vp fmt ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"globals": "^17.6.0",
		"svelte": "^5.57.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "^2.1.1",
		"vite-plus": "1.4.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	}
}
